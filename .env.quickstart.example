# URL the frontend container can use to reach Hubuum Server.
# Leave empty and set SETUP_KEY to configure the connection in your browser.
# For a remote server, use its normal HTTPS URL.
# For Docker Engine on Linux, host.docker.internal may require an explicit
# host-gateway mapping; see docs/quickstart-compose.md.
BACKEND_BASE_URL=https://hubuum-api.example.com
SETUP_KEY=

# Optional local overrides.
HUBUUM_FRONTEND_PORT=3000
HUBUUM_FRONTEND_IMAGE=ghcr.io/hubuum/hubuum-frontend:v0.0.25
NEXT_PUBLIC_APP_NAME=Hubuum Console
SESSION_TTL_SECONDS=28800
SESSION_PREFIX=hubuum:sess:
SETTINGS_PREFIX=hubuum:settings:

# Optional host directory mounted read-only into the frontend container.
LOGIN_BACKGROUNDS_HOST_DIR=./login-backgrounds
