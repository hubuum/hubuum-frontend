{
	"name": "hubuum-frontend",
	"version": "0.0.14",
	"private": true,
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "node scripts/dev-server.mjs",
		"dev:deps": "bash scripts/dev-deps.sh up",
		"dev:deps:down": "bash scripts/dev-deps.sh down",
		"build": "next build",
		"perf:budget": "node scripts/check-performance-budgets.mjs",
		"release:dependencies": "node scripts/check-release-dependencies.mjs",
		"start": "node scripts/start-standalone.mjs",
		"test": "vitest run",
		"test:performance-budget": "node --test scripts/check-performance-budgets.test.mjs",
		"test:release-dependencies": "node --test scripts/check-release-dependencies.test.mjs",
		"test:dev-deps": "node --test scripts/dev-deps.test.mjs",
		"test:server-options": "node --test scripts/server-options.test.mjs",
		"test:e2e": "playwright test",
		"test:e2e:authenticated": "bash scripts/authenticated-e2e-test.sh",
		"test:e2e:authenticated:full": "bash scripts/full-authenticated-e2e.sh",
		"test:e2e:public": "playwright test tests/e2e/public-ui.spec.ts --grep-invert 'public visual regression'",
		"test:e2e:visual": "playwright test tests/e2e/public-ui.spec.ts --grep 'public visual regression'",
		"test:e2e:update": "bash scripts/update-visual-baselines.sh",
		"test:live-backend": "scripts/live-backend-test.sh",
		"lint": "biome lint .",
		"typecheck": "next typegen && tsc --noEmit",
		"gen:api": "npx --yes orval@8.30.0 --clean --config orval.config.mjs && node scripts/patch-generated-client-prefix.mjs",
		"audit:prod": "npm audit --omit=dev"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/lang-jinja": "^6.0.1",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.7.4",
		"@codemirror/view": "^6.43.11",
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@lezer/highlight": "^1.2.3",
		"@tanstack/react-query": "^5.102.8",
		"@types/prismjs": "^1.26.6",
		"codemirror": "^6.0.2",
		"fflate": "0.8.3",
		"ioredis": "^6.0.0",
		"next": "^16.3.4",
		"prismjs": "^1.30.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-simple-code-editor": "^0.14.1",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"zod": "^4.5.4"
	},
	"overrides": {
		"postcss": "8.5.28",
		"sharp": "0.35.4"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "^2.5.12",
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.5.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@typescript/native": "npm:typescript@^7.0.2",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vitest": "^5.0.0"
	},
	"allowScripts": {
		"fsevents@2.3.2": true,
		"fsevents@2.3.3": true
	}
}
